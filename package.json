{
  "name": "cursi",
  "version": "0.1.0",
  "private": true,
  "description": "Cursi - AI for your entire desktop",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "clean": "turbo run clean && rm -rf node_modules",
    "dev:api": "turbo run dev --filter=@cursi/api",
    "dev:desktop": "turbo run dev --filter=@cursi/desktop",
    "build:api": "turbo run build --filter=@cursi/api",
    "build:desktop": "turbo run build --filter=@cursi/desktop"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.9"
}
