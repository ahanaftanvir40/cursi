    "@fastify/rate-limit": "^10.2.1",
    "@types/node": "^22.10.5",
    "@types/pg": "^8.11.11",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.38.3",
    "fastify": "^5.2.1",
    "fastify-plugin": "^5.0.1",
    "jose": "^5.10.0",
    "openai": "^4.78.1",
    "pg": "^8.13.1",
    "pino-pretty": "^13.1.3",
    "typescript": "5.7.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "drizzle-kit": "^0.30.1",
    "tsx": "^4.19.2"
