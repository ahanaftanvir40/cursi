# ─── API ──────────────────────────────────────────────────────────────────────
PORT=3001

# PostgreSQL connection string (Supabase or local)
DATABASE_URL=postgresql://postgres:password@localhost:5432/cursi

# Supabase — used for JWT validation on the API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# OpenAI — NEVER put this in the desktop app
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

# ─── Desktop ──────────────────────────────────────────────────────────────────
# Supabase public keys (safe for renderer — no secret)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Backend URL used by the desktop app
VITE_API_URL=http://localhost:3001
